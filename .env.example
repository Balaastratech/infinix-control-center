# `npm run setup` creates .env.local and generates the two secrets if they are missing.
# Secrets: random, at least 32 characters. Callers send WEBHOOK_SECRET as the X-Webhook-Secret header.
SESSION_SECRET=
WEBHOOK_SECRET=
DATABASE_PATH=./data/app.db
MOCK_BASE_URL=http://127.0.0.1:8765
# Next.js reads PORT from the process environment (e.g. `PORT=4000 npm start`), not from .env files.
PORT=3000
# Assistant (docs/assistant-design.md). The built-in parser always works without any key.
# AI layer: only on the server. Set ANTHROPIC_API_KEY in the server's environment, never in this folder.
# ANTHROPIC_API_KEY=
ASSISTANT_AI=on
ASSISTANT_MODEL=claude-sonnet-5-5
ASSISTANT_GLOBAL_DAILY=60
ASSISTANT_USER_DAILY=15
ASSISTANT_RETENTION_DAYS=7
ASSISTANT_MAX_MESSAGES=20
ASSISTANT_MAX_CONVERSATIONS=20
ASSISTANT_MAX_CHARS=500
