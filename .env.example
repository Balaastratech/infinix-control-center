# `npm run setup` creates .env.local and generates the two secrets if they are missing.
# Secrets: random, at least 32 characters. Callers send WEBHOOK_SECRET as the X-Webhook-Secret header.
SESSION_SECRET=
WEBHOOK_SECRET=
DATABASE_PATH=./data/app.db
MOCK_BASE_URL=http://127.0.0.1:8765
# Next.js reads PORT from the process environment (e.g. `PORT=4000 npm start`), not from .env files.
PORT=3000
